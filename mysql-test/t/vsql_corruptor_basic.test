# Install extension
INSTALL EXTENSION vsql_corruptor;

--echo #
--echo # Setup test database and tables
--echo #
CREATE DATABASE test_corrupt_db;
USE test_corrupt_db;

CREATE TABLE customers (
  id INT PRIMARY KEY,
  first_name VARCHAR(50),
  last_name VARCHAR(50)
);

CREATE TABLE orders (
  id INT PRIMARY KEY,
  customer_id INT,
  order_date DATE,
  amount DECIMAL(10,2)
);

# Enable schema cache worker
--disable_query_log
SET GLOBAL vsql_corruptor.schema_cache_enabled = ON;
--enable_query_log

# Wait for the schema cache to be populated
--let $wait_counter= 100
while ($wait_counter)
{
  --let $ready= query_get_value(SELECT vsql_schema_cache_ready() AS r, r, 1)
  if ($ready)
  {
    --let $wait_counter= 0
  }
  if (!$ready)
  {
    sleep 0.1;
    --dec $wait_counter
  }
}

--echo #
--echo # Test basic vsql_corrupt function using explicit schema strings
--echo #

# Test 1: vsql_corrupt using explicit schema string (specific type)
SELECT vsql_corrupt('SELECT first_name, last_name FROM customers WHERE id = 30', 'COMPARISON_OPERATOR_SWAP', 'customers:first_name VARCHAR,last_name VARCHAR,id INT') AS db_comparison_swap;

# Test 2: vsql_corrupt using explicit schema string (random type)
SELECT LENGTH(vsql_corrupt('SELECT first_name, last_name FROM customers WHERE id = 30', 'RANDOM', 'customers:first_name VARCHAR,last_name VARCHAR,id INT')) > 0 AS has_random_output;

# Test 3: vsql_corrupt using explicit schema string (type incompatibility)
SELECT vsql_corrupt('SELECT first_name FROM customers WHERE first_name = \'Alice\'', 'TYPE_INCOMPATIBILITY', 'customers:first_name VARCHAR,id INT') AS db_type_swap;

--echo #
--echo # Test basic vsql_corrupt function using explicit schema string
--echo #

# Test 4: vsql_corrupt using explicit schema string (specific type)
SELECT vsql_corrupt('SELECT first_name FROM customers WHERE first_name = \'Alice\'', 'TYPE_INCOMPATIBILITY', 'customers:first_name VARCHAR,id INT') AS custom_schema_swap;

# Test 5: vsql_corrupt using explicit schema string
SELECT vsql_corrupt('SELECT first_name FROM customers WHERE first_name = \'Alice\'', 'TYPE_INCOMPATIBILITY', 'customers:first_name VARCHAR,id INT') AS custom_schema_swap_explicit_db;

# Test 6: invalid inputs and error handling
--error 3200
SELECT vsql_corrupt('SELECT name FROM users', 'INVALID_TYPE_NAME', 'customers:first_name VARCHAR,id INT');

# Test 7: invalid database name (verifies the existence check)
--error 3200
SELECT vsql_corrupt('SELECT name FROM users', 'RANDOM', 'non_existent_db');

# Test 8: vsql_corrupt using dynamic schema from test_corrupt_db
SELECT vsql_corrupt('SELECT first_name FROM customers WHERE first_name = \'Alice\'', 'TYPE_INCOMPATIBILITY', 'test_corrupt_db') AS db_schema_swap;

--echo #
--echo # Cleanup
--echo #

DROP DATABASE test_corrupt_db;
USE test;

# Disable schema cache worker
--disable_query_log
SET GLOBAL vsql_corruptor.schema_cache_enabled = OFF;
--enable_query_log

# Uninstall extension
UNINSTALL EXTENSION vsql_corruptor;
