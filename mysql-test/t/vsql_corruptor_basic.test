# Install extension
INSTALL EXTENSION vsql_corruptor;

--echo #
--echo # Test basic vsql_corrupt function
--echo #

# Test 1: vsql_corrupt with 2 arguments (specific type)
SELECT vsql_corrupt('SELECT name, age FROM users WHERE age = 30', 'COMPARISON_OPERATOR_SWAP') AS comparison_swap;

# Test 2: vsql_corrupt with 1 argument (random type, check output is generated)
SELECT LENGTH(vsql_corrupt('SELECT name, age FROM users WHERE age = 30')) > 0 AS has_random_output;

# Test 3: vsql_corrupt with 3 arguments (custom schema, specific type)
SELECT vsql_corrupt('SELECT first_name FROM customers WHERE first_name = \'Alice\'', 'TYPE_INCOMPATIBILITY', 'customers:first_name VARCHAR,id INT') AS custom_schema_swap;

# Test 4: vsql_corrupt_with_schema with 3 arguments
SELECT vsql_corrupt_with_schema('SELECT first_name FROM customers WHERE first_name = \'Alice\'', 'TYPE_INCOMPATIBILITY', 'customers:first_name VARCHAR,id INT') AS custom_schema_swap_explicit;

# Test 5: invalid inputs and error handling
--error 3200
SELECT vsql_corrupt('SELECT name FROM users', 'INVALID_TYPE_NAME');

--echo #
--echo # Cleanup
--echo #

# Uninstall extension
UNINSTALL EXTENSION vsql_corruptor;
